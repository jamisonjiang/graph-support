digraph ParallelAndSelfEdges {
  graph [
    rankdir="LR"
    bgcolor="#F7F9FC"
    nodesep="0.58"
    ranksep="0.66"
    splines="spline"
  ]

  node [
    shape="rect"
    style="rounded,filled"
    fontname="Arial"
    fontsize="10"
    color="#CBD5E1"
    fillcolor="#FFFFFF"
    fontcolor="#1E293B"
    margin="0.18"
  ]

  edge [fontname="Arial" fontsize="8" arrowsize="0.65" penwidth="1.35"]

  producer [color="#6366F1" fillcolor="#EEF2FF" label=< <B>PRODUCER</B> >]
  consumer [color="#10B981" fillcolor="#ECFDF5" label=< <B>CONSUMER</B> >]

  producer -> consumer [label="sync" color="#6366F1"]
  producer -> consumer [label="async" color="#10B981" style="dashed"]
  producer -> consumer [label="audit" color="#F59E0B" style="dotted"]
  consumer -> consumer [label="retry" color="#FB7185" arrowhead="vee"]
  consumer -> producer [label="ack" color="#94A3B8" constraint="false"]
}
