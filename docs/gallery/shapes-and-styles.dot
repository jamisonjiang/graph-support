digraph ShapesAndStyles {
  graph [
    rankdir="TB"
    bgcolor="#F7F9FC"
    nodesep="0.38"
    ranksep="0.48"
  ]

  node [
    fontname="Arial"
    fontsize="10"
    fontcolor="#1E293B"
    penwidth="1.4"
    style="filled"
    margin="0.12"
  ]

  service [shape="rect" style="rounded,filled" color="#818CF8" fillcolor="#EEF2FF" label=< <B>SERVICE</B><BR/><FONT POINT-SIZE="8">rounded rect</FONT> >]
  decision [shape="diamond" color="#F59E0B" fillcolor="#FFFBEB" label=< <B>DECIDE</B><BR/><FONT POINT-SIZE="8">diamond</FONT> >]
  datastore [shape="cylinder" color="#2DD4BF" fillcolor="#F0FDFA" label=< <B>DATA</B><BR/><FONT POINT-SIZE="8">cylinder</FONT> >]
  event [shape="circle" color="#FB7185" fillcolor="#FFF1F2" label=< <B>EVENT</B><BR/><FONT POINT-SIZE="8">circle</FONT> >]
  queue [shape="hexagon" color="#A78BFA" fillcolor="#F5F3FF" label=< <B>QUEUE</B><BR/><FONT POINT-SIZE="8">hexagon</FONT> >]
  output [shape="parallelogram" color="#38BDF8" fillcolor="#F0F9FF" label=< <B>OUTPUT</B><BR/><FONT POINT-SIZE="8">parallelogram</FONT> >]

  service -> decision -> datastore [style="invis"]
  event -> queue -> output [style="invis"]
  { rank="same" service decision datastore }
  { rank="same" event queue output }
}
