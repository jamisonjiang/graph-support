digraph EdgeRouting {
  graph [
    rankdir="LR"
    bgcolor="#F7F9FC"
    nodesep="0.38"
    ranksep="0.48"
    splines="spline"
  ]

  node [
    shape="circle"
    style="filled"
    fixedsize="true"
    width="0.52"
    height="0.52"
    fontname="Arial"
    fontsize="9"
    color="#CBD5E1"
    fillcolor="#FFFFFF"
    fontcolor="#1E293B"
  ]

  edge [fontname="Arial" fontsize="8" arrowsize="0.72" penwidth="1.4"]

  source [color="#6366F1" fillcolor="#EEF2FF" label="SRC"]
  fast [label="FAST"]
  retry [label="RETRY"]
  audit [label="AUDIT"]
  sink [color="#10B981" fillcolor="#ECFDF5" label="DST"]

  source -> fast [label="normal" color="#6366F1" arrowhead="normal"]
  source -> retry [label="vee" color="#F59E0B" arrowhead="vee" style="dashed"]
  source -> audit [label="dot" color="#FB7185" arrowhead="dot" style="dotted"]
  fast -> sink [color="#10B981" penwidth="2"]
  retry -> sink [color="#94A3B8"]
  audit -> sink [color="#94A3B8"]

  { rank="same" fast retry audit }
}
