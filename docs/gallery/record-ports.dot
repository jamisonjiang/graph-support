digraph RecordPorts {
  graph [
    rankdir="LR"
    bgcolor="#F7F9FC"
    nodesep="0.48"
    ranksep="0.58"
    splines="spline"
  ]

  node [
    fontname="Arial"
    fontsize="10"
    color="#CBD5E1"
    fontcolor="#1E293B"
    style="filled"
    fillcolor="#FFFFFF"
    penwidth="1.25"
  ]

  request [
    shape="record"
    color="#818CF8"
    fillcolor="#EEF2FF"
    label="{REQUEST|{<headers>headers|<body>body}|{<auth>auth|<trace>trace}}"
  ]

  identity [shape="rect" style="rounded,filled" fillcolor="#ECFDF5" color="#6EE7B7" label="IDENTITY"]
  processor [shape="rect" style="rounded,filled" fillcolor="#F0F9FF" color="#7DD3FC" label="PROCESSOR"]
  telemetry [shape="rect" style="rounded,filled" fillcolor="#FFF7ED" color="#FDBA74" label="TELEMETRY"]

  request:auth -> identity [label="verify" color="#10B981"]
  request:body -> processor [label="payload" color="#3B82F6"]
  request:trace -> telemetry [label="span" color="#F59E0B"]
}
